# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://homesite:homesite@127.0.0.1:5433/homesite"

# Auth.js — generate with: openssl rand -base64 32
# Required in production. Do not commit real secrets.
AUTH_SECRET="replace-with-32-plus-random-bytes"
AUTH_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# First staff admin (used only by `npx prisma db seed`, never by public signup)
BOOTSTRAP_ADMIN_EMAIL="admin@goodcode.local"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-12-plus-chars"

# AI intake
OPENAI_API_KEY=""
PROJECT_BLUEPRINT_AI_INTAKE_ENABLED="true"
PROJECT_BLUEPRINT_AI_INTAKE_MODEL="gpt-4o-mini"
PROJECT_BLUEPRINT_AI_ESTIMATE_ENABLED="true"
PROJECT_BLUEPRINT_AI_ESTIMATE_MODEL="gpt-4o"

# Optional social sign-in. Omit or leave blank to hide the buttons.
# Callback URLs: {AUTH_URL}/api/auth/callback/{google|github|microsoft-entra-id}
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Optional; defaults to work + personal Microsoft accounts
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# Optional product integrations
RESEND_API_KEY=""
RESEND_FROM_EMAIL="estimates@goodcode.co.za"
